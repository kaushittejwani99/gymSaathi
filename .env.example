# Copy this file to .env and fill it in. Never upload .env anywhere.

PORT=3000

# Your owner account. You sign in with this and create a login for each gym on the Accounts page.
# It is kept only here, not in the database. The password needs 8 characters or more.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Where the data is kept.
# Empty: JSON files in DATA_DIR on this computer (fine for trying it out, or a host with a disk).
# Set:   a MongoDB database. The free tier of MongoDB Atlas is enough, and lets a free host with no disk keep data.
#        It looks like mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ with your own password typed in.
#        Then run `node test.js mongo` once to check that it works.
MONGODB_URI=
DATA_DIR=./data

# Shown to a gym when it is asked to pay: where the money goes.
# PAY_NOTE=UPI yourname@bank, or call 98290 00000

# Google Gemini key (free from Google AI Studio). Without it the assistant still works, with simpler understanding.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite,gemini-3.5-flash-lite

# On a host behind HTTPS and a proxy (Render and the like):
# COOKIE_SECURE=1
# TRUST_PROXY=1
# TZ=Asia/Kolkata
